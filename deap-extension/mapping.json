{
  "_about": "Starting guesses at how DEAP labels each survey value. Keys are the survey app's field ids. 'labels' are DEAP label texts to look for, 'selector' pins an exact DEAP field, 'values' maps a survey answer to DEAP's wording, 'skip' leaves a value out. Fields you teach in the side panel are saved on top of this file. Tables are filled one row at a time into DEAP's Add dialog unless the table key has \"dialog\": false. Walls selectors confirmed from live DEAP on 2026-10-28.",
  "screens": {
    "details": {
      "url": "/details|dwelling"
    },
    "dims": {
      "url": "building/(floors?|dimensions)"
    },
    "roofs": {
      "url": "building/roofs?"
    },
    "walls": {
      "url": "building/walls?"
    },
    "openings": {
      "url": "building/(windows?|doors?|openings)"
    },
    "fabric": {
      "url": "building/(rooms?|global|thermal)"
    },
    "vent": {
      "url": "ventilation"
    },
    "heat": {
      "url": "space-?heating|heating/space"
    },
    "water": {
      "url": "water-?heating|heating/water"
    },
    "gen": {
      "url": "renewable|generation|pv|photovoltaic"
    }
  },
